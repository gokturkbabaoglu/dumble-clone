JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
Text="C15 = {C15V}: tasarim 253p (220p+33p), takilacak hal 330p. R5 = {R5V}: 33k / 32k."
Px=48,896
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

