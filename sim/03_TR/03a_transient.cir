Px=592,120
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
Text="V3"
Px=912,120
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
Text="C6/C7: TDA2003 yanindaki dekuplaj. LED (R3+D2) simule edilmedi (~4 mA)."
Px=48,240
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
Text="2) GIRIS + JFET (BF245B) + GAIN + SW1 + LM386"
