[Grid Text]
Text="RV1A/RV1B = GAIN potu B100K (konum: GAIN, 0..1). CB = 470p (SW=1 Bright), CD = 3.3n (SW=-1 Dark)."
Px=48,560
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
Text="TR1 = {RSRC} (drain ~7 V'a ayarli). C9 = {C9V}: 22u takili / 1p yok."
Px=48,576
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

