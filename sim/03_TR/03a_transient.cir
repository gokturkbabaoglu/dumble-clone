[Grid Text]
Text="1) BESLEME: 12 V adaptor - 1N5822 - RC filtreler (V12 / V2 / V3)"
Px=48,64
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
Text="V12"
Px=464,120
GridSnap=True
JustifyH=Left
JustifyV=Bottom
CBorder=None

[Grid Text]
